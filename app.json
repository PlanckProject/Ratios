{
  "expo": {
    "name": "Ratios",
    "slug": "ratios-collage-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ratios",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.planckproject.ratios"
    },
    "android": {
      "package": "org.planckproject.ratios",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090909"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ratios needs access to your photos and videos so you can build collages."
        }
      ],
      "expo-document-picker",
      "expo-media-library"
    ]
  }
}
